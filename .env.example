# Database
POSTGRES_DB=llmwrapper
POSTGRES_USER=llmwrapper
POSTGRES_PASSWORD=llmwrapper
DB_URL=jdbc:postgresql://db:5432/llmwrapper
DB_USERNAME=llmwrapper
DB_PASSWORD=llmwrapper

# JWT (must be at least 32 bytes)
JWT_SECRET=dev-secret-change-me-in-production-must-be-at-least-32-bytes-long-for-hs256
JWT_EXPIRATION_MS=86400000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:5173

# LLM provider API keys (leave blank to disable that provider)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
